# droplet-newulife-payment (Next.js) — example environment.
#
# Copy to .env and fill in real values. Never commit .env.
#
# The Rails app's own example lives in .env.local.example. Both apps read the
# same DATABASE_URL: the Prisma schema maps every model back to the existing
# Rails tables, and there is no data migration.

# ============================================================================
# REQUIRED — the droplet itself
# ============================================================================

# The droplet's database. The SAME database the Rails app uses.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/droplet_newulife_payment_development

# Signing key for the Auth.js session cookie. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out; it is not related to any Fluid credential.
AUTH_SECRET=

# Public URL of this droplet. Used to build the webhook and callback URLs sent
# to Fluid at registration, and — critically — to tell OUR callback
# registrations apart from those of other droplets installed for the same
# company. Locally this is your ngrok URL; in production the Cloud Run URL.
#
# Matched EXACTLY: a trailing slash or an http/https mismatch adopts nothing.
FLUID_DROPLET_URL=http://localhost:3000

# The SECOND address this same service answers on, if it has one. Cloud Run
# serves one service on both `<service>-<suffix>.a.run.app` and
# `<service>-<projectNumber>.<region>.run.app`, and which form a callback was
# registered under depends on how the droplet was configured at the time.
#
# Read by the SDK's backfill only, and only to widen which registrations count
# as ours — ownership is an exact URL match, so a registration that IS ours but
# sits on the sibling hostname is otherwise skipped and its callbacks refused
# once verification is enforced. Non-https values are ignored.
FLUID_DROPLET_ALT_URL=

# The shared token Fluid signs droplet.installed / droplet.uninstalled with.
# Accepted ONLY for those two events — a company's own webhook token is never a
# legitimate signer for a lifecycle event, and accepting one is a cross-tenant
# takeover.
FLUID_WEBHOOK_AUTH_TOKEN=

# ============================================================================
# REQUIRED — the money path
# ============================================================================

# Where the shopper is sent BACK to after paying at uPayments, and where they
# are sent when they cancel. DROPLET_HOST_URL is baked into every uPayments
# order at creation time, so changing it does not move orders that are already
# open — see CUTOVER.md.
DROPLET_HOST_URL=http://localhost:3000
CHECKOUT_HOST_URL=https://checkout.example.com

# ByDesign. HTTP Basic on both the consumer and the payment APIs.
BY_DESIGN_API_URL=
BY_DESIGN_INTEGRATION_USERNAME=
BY_DESIGN_INTEGRATION_PASSWORD=

# uPayments users API. The private key signs RS512 JWTs; the api code is the
# `sub` claim. A literal `\n` in the key is converted to a real newline, so a
# single-line value works.
UPAYMENTS_USERS_API_URL=
NEWULIFE_PRIVATE_KEY=
NEWULIFE_API_CODE=

# uPayments checkout API. Separate key and api code from the users API.
UPAYMENTS_CHECKOUT_API_URL=
UPAYMENTS_MC_PRIVATE_KEY=
UPAYMENTS_MC_API_CODE=

# HMAC-SHA256 secret for the inbound Moola webhook.
#
# REQUIRED, and the Next app refuses every delivery without it. That is the one
# deliberate behaviour change on this path: the Rails controller verifies the
# signature only `if: :signature_verification_enabled?`, which is true only when
# this variable is set — so an unset value makes the endpoint accept anything,
# and an unauthenticated caller can post a crafted invoice_number and drive the
# ByDesign recording path. Fails closed here.
MOOLA_WEBHOOK_SECRET=

# ============================================================================
# OPTIONAL
# ============================================================================

# Base URL for outbound calls to the Fluid API. Defaults to
# https://api.fluid.app. The `fluid_api` settings row overrides this for calls
# made through the admin UI and for the checkout paths.
# FLUID_API_URL=https://api.fluid.app

# This droplet's uuid, as issued by Fluid. Install events naming a different
# droplet are ignored. Normally read from the `droplet` settings row (which
# `Create Droplet` fills in); set this only if you need to guard before that
# row exists.
# DROPLET_UUID=

# ============================================================================
# SCRIPTS ONLY — not read by the running app
# ============================================================================

# Used by `pnpm setup:create-admin` to create the first admin user.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
